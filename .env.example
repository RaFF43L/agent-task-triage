# general
APP_NAME=4dev-lang-graph
APP_ENV=dev

# logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# aws / bedrock
AWS_REGION=us-east-1

# llm — o transporte é DERIVADO de LLM_BASE_URL (strategy):
#   vazio = Bedrock (credenciais AWS); localhost:11434 = Ollama;
#   qualquer outro = API OpenAI-compatível (api.openai.com, vLLM, LM Studio...)
LLM_BASE_URL=
MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Judge model (LLM-as-judge); default = MODEL
MODEL_JUDGE=
# Chave para transportes OpenAI-compatíveis; default = OPENAI_API_KEY do ambiente
LLM_API_KEY=

# embeddings — transporte derivado de EMBED_BASE_URL (mesma regra do LLM)
EMBED_BASE_URL=
EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# agent behavior
MAX_TOKENS=4096
TOOL_MAX_TOKENS=700
RECURSION_LIMIT=25
# Evaluation mode: 'simple' (fast) or 'detailed' (multi-dimensional with scores)
EVAL_MODE=simple

# rag / pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
RAG_COLLECTION=documents
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
